# /etc/afar/afar.env — the conductor's environment (systemd EnvironmentFile).
# Copy, fill, chmod 0600. NEVER commit a filled copy.

# --- the master switch (ships OFF; flip to 1 + `systemctl restart afar`) -----
AFAR_ENABLED=0

# --- spend controls -----------------------------------------------------------
# The live loop books ALBUMS: one artist, one whole record, per turn.
# 3 records/day x (4 songs x 120s) = 24 audio-minutes/day, well inside the cap.
AFAR_ALBUMS_PER_DAY=3
AFAR_ALBUM_TRACKS=4
AFAR_TRACK_SECONDS=120
# Hard daily gate, in generated audio-MINUTES (the $500/mo sizing).
# Minutes — what actually costs money — are what is capped; the conductor
# shrinks the last record of a day to fit rather than overspending.
AFAR_DAILY_AUDIO_MINUTES=110
# The round-based experiment instrument (AFAR_EXPERIMENT_MODE=1) paces on this.
AFAR_SETS_PER_DAY=3

# --- adapters -----------------------------------------------------------------
# elevenlabs + mert for the real piece; mock + mock for a supervised smoke.
AFAR_RENDERER=elevenlabs
AFAR_EMBEDDER=mert
AFAR_MODEL=claude-sonnet-5
AFAR_RUNS_ROOT=/root/projects/AFAR/runs

# --- keys (required live; never printed, never committed) --------------------
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
DATABASE_URL=

# --- ops ----------------------------------------------------------------------
# Optional webhook for heal/notify messages (plain text POST).
AFAR_NOTIFY_URL=
