# /etc/afar/afar.env — the conductor's environment (systemd EnvironmentFile).
# Copy, fill, chmod 0600. NEVER commit a filled copy.

# --- the master switch (ships OFF; flip to 1 + `systemctl restart afar`) -----
AFAR_ENABLED=0

# --- the ask rhythm -----------------------------------------------------------
# The live loop books NOBODY. Each tick it knocks on a few doors and asks
# whether that artist has a record in it; the artists decide. These are a
# cadence, not a quota — how many records a day happen is up to the town.
# 8 ticks/day x 3 doors = up to 24 asks/day; at the absolute ceiling (everyone
# always says yes) that is 8 records x 8 audio-minutes = 64 min, inside the cap.
AFAR_ASKS_PER_DAY=8
AFAR_ASKS_PER_TICK=3
# A declining artist is left alone: 12h after the first no, doubling per
# consecutive no, capped at a week so nobody is ever silenced by arithmetic.
# An artist that just said yes waits a day.
AFAR_ASK_COOLDOWN_HOURS=12
AFAR_ASK_COOLDOWN_MAX_HOURS=168
AFAR_RECORD_COOLDOWN_HOURS=24
# A yes whose record then died (a timeout, a bad reply): the yes is not spent,
# so the artist is asked again shortly rather than waiting out a full record.
AFAR_FAILED_COOLDOWN_HOURS=1

# --- spend controls -----------------------------------------------------------
AFAR_ALBUM_TRACKS=4
AFAR_TRACK_SECONDS=120
# Hard daily gate, in generated audio-MINUTES (the $500/mo sizing).
# Minutes — what actually costs money — are what is capped; the conductor
# shrinks the last record of a day to fit rather than overspending.
AFAR_DAILY_AUDIO_MINUTES=110
# The round-based experiment instrument (AFAR_EXPERIMENT_MODE=1) paces on this.
AFAR_SETS_PER_DAY=3

# --- adapters -----------------------------------------------------------------
# elevenlabs + mert for the real piece; mock + mock for a supervised smoke.
AFAR_RENDERER=elevenlabs
AFAR_EMBEDDER=mert
AFAR_MODEL=claude-sonnet-5
# The ask happens far more often than a record does, so it runs cheap.
AFAR_ASK_MODEL=claude-haiku-4-5
AFAR_RUNS_ROOT=/root/projects/AFAR/runs

# --- keys (required live; never printed, never committed) --------------------
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
DATABASE_URL=

# --- ops ----------------------------------------------------------------------
# Optional webhook for heal/notify messages (plain text POST).
AFAR_NOTIFY_URL=
