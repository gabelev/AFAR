# afar kernel — copy to .env (never commit .env)

# Model provider for the players/staff. Unset => deterministic MockProvider.
ANTHROPIC_API_KEY=

# Audio renderer. Unset => MockRenderer (deterministic bytes, no network).
ELEVENLABS_API_KEY=

# Neon mirror. Unset => JSONL-only logging (still fully functional).
DATABASE_URL=

# Bindings (defaults shown)
AFAR_MODEL=claude-sonnet-5
AFAR_RENDERER=mock            # mock | elevenlabs
AFAR_EMBEDDER=mock            # mock | mert   (mert requires: uv sync --extra listen)
AFAR_RUNS_ROOT=../runs

# Chaos Dimension progress narration (optional; degrades to seeded in-memory)
CD_AGENT_TOKEN=
CD_WORKSTREAM=afar
